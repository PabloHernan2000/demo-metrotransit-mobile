# ==============================================================================
# MetroTransit Mobile - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before building or running the project:
#   cp .env.example .env
#
# SECURITY NOTE:
# Never commit real credentials, production API keys, or private certificates.
# ==============================================================================

# Core Backend REST API
# Base URL for MetroTransit REST services
API_BASE_URL=http://localhost:3001/v1/

# Broadcast & System Notifications Service
API_MESSAGES_URL=http://localhost:3001/v1/messages/

# Public Base Gateway
BASE_URL=http://localhost:3001

# WebSocket Real-Time Telemetry
# Socket endpoint for vehicle live coordinates streaming
TRACKING_SOCKET_URL=http://localhost:3001
TRACKING_SOCKET_PATH=/metrotransit/socket.io

# Google Maps SDK API Key
# Provide your client-side restricted Google Maps API key (iOS & Android)
GOOGLE_MAPS_API_KEY=AIzaSyDUMMY_KEY_FOR_DEMO_PURPOSES_ONLY

# App Behavior Flags
ENABLE_OFFLINE_CACHE=true
DEFAULT_CACHE_TTL_MS=3600000
